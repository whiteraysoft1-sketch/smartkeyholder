<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On
    RewriteBase /

    # Since users access /public/ directly, we don't need to rewrite
    # Just let the public/.htaccess handle routing within the public folder
    
    # Allow real files and directories to be served directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # If accessing /public/, let public/.htaccess handle it
    RewriteCond %{REQUEST_URI} ^/public/
    RewriteRule ^ - [L]
</IfModule>